# Firebase web client config is public, but it must refer to your own Firebase project.
FIREBASE_WEB_CONFIG={"apiKey":"","authDomain":"","projectId":"","appId":""}

# Backend Firebase Admin credentials. Use a service account locally or application default credentials in deployment.
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Optional local AI. The prototype uses a safe deterministic response when Ollama is absent.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# Optional Twilio inbound voice bridge. Configure a webhook at /api/twilio/voice.
PUBLIC_BASE_URL=https://your-public-host.example
TWILIO_AUTH_TOKEN=
TWILIO_OWNER_UID=

PORT=4174
NODE_ENV=development
