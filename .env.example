# Firebase web client config is public, but it must refer to your own Firebase project.
FIREBASE_WEB_CONFIG={"apiKey":"","authDomain":"","projectId":"","appId":""}

# Set for Capacitor builds so the installed app can reach the deployed API. Leave blank for same-origin web hosting.
VITE_API_BASE_URL=

# Backend Firebase Admin credentials. Use a service account locally or application default credentials in deployment.
FIREBASE_SERVICE_ACCOUNT=
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_PROJECT_ID=

# Required for live call responses. The configured Ollama model must already be installed and reachable by this server.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2

# Required for the live Twilio inbound voice bridge. Configure the number webhook at /api/twilio/voice.
PUBLIC_BASE_URL=https://your-public-host.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_OWNER_UID=

PORT=4174
NODE_ENV=development

# Optional comma-separated extra origins for a hosted web frontend or mobile webview.
APP_ORIGIN=
MOBILE_ORIGINS=
